#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
# "<the AppImage> xtal mcp" is the line an AI assistant's client is
# given: the xtal beside the window is inside this mount, which is gone
# once the window quits, and the AppImage file is not.
# xtal first always means the CLI: open a file named xtal as ./xtal.
if [ "$1" = xtal ]; then
    shift
    exec "$HERE/usr/lib/crystal-builder/xtal" "$@"
fi
# QT_QPA_PLATFORM is left alone: the window's own start-up chooses
# (xtalapp/main.py), as it does for every Linux install.  VTK's Qt
# bridge is X11 whatever Qt draws on, so a Wayland session runs the
# window on XWayland -- and only while the variable is unset, which a
# default here would never let it be.  One the user set still wins.
exec "$HERE/usr/lib/crystal-builder/crystal-builder" "$@"
