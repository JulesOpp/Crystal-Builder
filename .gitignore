__pycache__/
*.py[cod]
*.egg-info/
# Anchored: setuptools' build directory is the one at the root.  Bare
# `build/` also matches `xtal/build/`, the molecule builder, and would
# have kept the whole package out of the history without saying so.
/build/
dist/
.venv/
.pytest_cache/
.ruff_cache/
.DS_Store
*.xtalproj
resources/PTBP/
resources/test/
archive/

# Zeo++, unpacked into resources/ so the module finds it without an
# install.  78 MB of somebody else's source, object files and a built
# binary: it belongs on the machine, not in the history.  Set
# XTAL_ZEOPP, or put `network` on PATH, if it lives elsewhere.
resources/zeo++-0.3/

# The virtual environment PyInstaller builds against.  Not the
# developer's own: a windowed .app wants a python.org framework build,
# and the interpreter that happens to be first on PATH is usually
# conda's, whose vtkmodules is 592 MB and whose libpython layout makes
# a poor base for a bundle.  See docs/PACKAGING.md.
.venv-build/
